<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Университеты — QADAM</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
body{margin:0;background:#f7f5f0;color:#17243b;font-family:'DM Sans',sans-serif}
header{background:#101d35;color:white;padding:20px 7%;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:25px;letter-spacing:3px;color:#d5b779;font-weight:bold}
header a{color:white;text-decoration:none}
.hero{padding:65px 8%;background:linear-gradient(110deg,#101d35,#263c5c);color:white}
h1,h2{font-family:'Playfair Display',serif}
h1{font-size:clamp(38px,6vw,62px);margin:0 0 15px}
.hero p{max-width:650px;line-height:1.7;color:#e1e5ec}
main{padding:45px 8%}
.filters{display:grid;grid-template-columns:2fr 1fr;gap:12px;margin-bottom:30px}
input,select{width:100%;padding:15px;border:1px solid #d9dce2;border-radius:8px;background:white;font:inherit;color:#17243b}
h2{font-size:30px}
.country-title{margin:35px 0 18px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
.card{background:white;border:1px solid #e8e5de;border-radius:12px;padding:23px;display:flex;flex-direction:column;gap:12px}
.card h3{font-size:19px;margin:0}
.short{color:#98743d;font-weight:700;font-size:13px}
.details{color:#657084;font-size:14px;line-height:1.7}
.tags{display:flex;gap:7px;flex-wrap:wrap}
.tag{background:#f1eee7;padding:6px 9px;border-radius:5px;font-size:12px}
.card a{color:#98743d;font-weight:700;text-decoration:none;margin-top:auto}
.empty{padding:30px;text-align:center;color:#687386}
footer{background:#101d35;color:white;padding:28px;text-align:center;margin-top:50px}
@media(max-width:600px){.filters{grid-template-columns:1fr}main{padding:35px 6%}}
</style>
</head>
<body>
<header>
<div class="logo">QADAM</div>
<a href="index.html">← На главную</a>
</header>

<div class="hero">
<h1>Университеты мира</h1>
<p>Изучай образовательные возможности, сравнивай университеты и переходи к официальным источникам для поступления.</p>
</div>

<main>
<h2>Каталог университетов</h2>
<div class="filters">
<input id="search" type="search" placeholder="Название университета или специальность...">
<select id="country">
<option value="all">Все страны</option>
</select>
</div>
<div id="catalog"></div>
</main>

<footer>QADAM — твой путь к международному образованию</footer>

<script src="data.js"></script>
<script>
const catalog = document.getElementById("catalog");
const countrySelect = document.getElementById("country");
const searchInput = document.getElementById("search");

QADAM_DATA.countries.forEach(country => {
  const option = document.createElement("option");
  option.value = country.id;
  option.textContent = country.name;
  countrySelect.appendChild(option);
});

function renderCatalog(){
  const selectedCountry = countrySelect.value;
  const query = searchInput.value.toLowerCase().trim();
  catalog.innerHTML = "";
  let total = 0;

  QADAM_DATA.countries.forEach(country => {
    if(selectedCountry !== "all" && selectedCountry !== country.id) return;

    const universities = country.universities.filter(university => {
      const searchable = [
        university.name,
        university.shortName,
        university.city,
        ...university.fields,
        ...university.funding
      ].join(" ").toLowerCase();

      return searchable.includes(query);
    });

    if(!universities.length) return;

    total += universities.length;

    const section = document.createElement("section");
    const title = document.createElement("h2");
    title.className = "country-title";
    title.textContent = country.name;

    const cards = document.createElement("div");
    cards.className = "cards";

    universities.forEach(university => {
      const card = document.createElement("article");
      card.className = "card";

      const name = document.createElement("h3");
      name.textContent = university.name;

      const short = document.createElement("div");
      short.className = "short";
      short.textContent = university.shortName;

      const details = document.createElement("div");
      details.className = "details";
      details.textContent = "📍 " + university.city + " · " + university.country;

      const fields = document.createElement("div");
      fields.className = "tags";
      university.fields.forEach(field => {
        const tag = document.createElement("span");
        tag.className = "tag";
        tag.textContent = field;
        fields.appendChild(tag);
      });

      const funding = document.createElement("div");
      funding.className = "details";
      funding.textContent = "Финансирование: " + university.funding.join(", ");

      const link = document.createElement("a");
      link.href = university.website;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = "Официальный сайт →";

      card.append(name, short, details, fields, funding, link);
      cards.appendChild(card);
    });

    section.append(title, cards);
    catalog.appendChild(section);
  });

  if(total === 0){
    catalog.innerHTML = '<div class="empty">По вашему запросу ничего не найдено.</div>';
  }
}

searchInput.addEventListener("input", renderCatalog);
countrySelect.addEventListener("change", renderCatalog);
renderCatalog();
</script>
</body>
</html>
